---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicationShortLabel } from '../lib/publication';
const notes = (await getCollection('notes', ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
const iesues = notes.filter(note => note.data.format === 'iesue').sort((a,b)=>a.data.iesue!-b.data.iesue!);
const other = notes.filter(note => note.data.format !== 'iesue');
const month = new Intl.DateTimeFormat('en-US',{month:'long',year:'numeric',timeZone:'UTC'});
const fmt = new Intl.DateTimeFormat('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'});
---
<BaseLayout title="The archive" description="The monthly Iesues of The Yes-Way. Essays on self-awareness, service, learning, and choosing your own path.">
  <section class="journal-intro">
    <p class="theme-label">The Yes-Way / Collected writing</p>
    <h1>A practice.<br />One Iesue at a time.</h1>
    <p>Questions worth staying with. Research, reflection, and practical ways to bring more care to how we learn, lead, and live.</p>
    <div class="journal-index"><a href="#iesues">{iesues.length} monthly Iesues ↓</a><a href="#practical">Practical notes ↓</a><a href="/topics/">Explore by topic →</a></div>
  </section>
  <section class="series-archive" id="iesues" aria-labelledby="series-title">
    <header class="section-heading"><div><p class="theme-label">The monthly series</p><h2 id="series-title">The Iesues</h2></div><span>Begin at 001. Follow your questions.</span></header>
    <ol class="issue-list">
      {iesues.map(note => <li><a href={`/${note.slug}/`}>
        <span class="issue-index">{String(note.data.iesue).padStart(3,'0')}</span>
        <div class="issue-detail"><small>The {note.data.theme ?? 'Weight'}</small><h3>{note.data.title}</h3><p>{note.data.description}</p></div>
        <div class="issue-date"><time datetime={note.data.date.toISOString()}>{month.format(note.data.date)}</time><span aria-hidden="true">↗</span></div>
      </a></li>)}
    </ol>
  </section>
  <section class="practical-archive" id="practical" aria-labelledby="practical-title">
    <header class="section-heading"><div><p class="theme-label">Along the way</p><h2 id="practical-title">Practical notes</h2></div></header>
    <ol class="archive-list">{other.map(note => <li><a href={`/${note.slug}/`}><span class="archive-number">{publicationShortLabel(note.data.format)}</span><div><small>{note.data.topic}</small><strong>{note.data.title}</strong><p>{note.data.description}</p></div><time datetime={note.data.date.toISOString()}>{fmt.format(note.data.date)}</time><span aria-hidden="true">→</span></a></li>)}</ol>
  </section>
</BaseLayout>
