---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const notes = await getCollection('notes', ({ data }) => !data.draft);
const counts = new Map<string, number>();
for (const note of notes) counts.set(note.data.topic, (counts.get(note.data.topic) ?? 0) + 1);
const topics = [...counts.entries()].sort(([a], [b]) => a.localeCompare(b));
const slug = (value: string) => value.toLowerCase().replace(/\s+/g, '-');
---
<BaseLayout title="Topics" description="Explore The Yes-Way by subject.">
  <section class="page-intro wrap">
    <a class="back-link" href="/archive/">← The archive</a>
    <h1>Topics</h1>
    <p>Browse every form of The Yes-Way by subject.</p>
  </section>
  <div class="wrap">
    <ul class="topic-grid">
      {topics.map(([topic, count], i) => <li class="reveal" style={`--d:${i * 0.05}s`}><a class="panel glow-card" href={`/topics/${slug(topic)}/`}><span>{topic}</span><small>{count} {count === 1 ? 'note' : 'notes'}<b aria-hidden="true">→</b></small></a></li>)}
    </ul>
  </div>
</BaseLayout>
