---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { publicationLabel } from '../lib/publication';
import ShareBar from '../components/ShareBar.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map(note => ({ params: { slug: note.slug }, props: { note } }));
}
const { note } = Astro.props;
const { Content } = await note.render();
const fmt = new Intl.DateTimeFormat('en-US', { month:'long', day:'numeric', year:'numeric', timeZone:'UTC' });
const topicSlug = note.data.topic.toLowerCase().replace(/\s+/g,'-');
const noteLabel = publicationLabel(note.data.format, note.data.iesue);
const isIesue = note.data.format === 'iesue';
const series = (await getCollection('notes', ({ data }) => !data.draft && data.format === 'iesue')).sort((a,b) => a.data.iesue! - b.data.iesue!);
const position = series.findIndex(item => item.slug === note.slug);
const previous = position > 0 ? series[position - 1] : null;
const next = position >= 0 ? series[position + 1] : null;
const wordCount = note.body
  .replace(/<[^>]*>/g, ' ')
  .replace(/\[[^\]]*\]\([^)]*\)/g, ' ')
  .split(/\s+/)
  .filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 220));
---
<BaseLayout scene="article" socialImage={`/social/${note.slug}.png`} title={note.data.title} description={note.data.description} type="article" publishedTime={note.data.published ?? note.data.date} updatedTime={note.data.updated}>
  <div class="progress" data-progress aria-hidden="true"></div>
  <article class:list={['article', { 'iesue-article': isIesue }]} data-yes={note.data.theme}>
    <div class="wrap">
      <header class="article-head">
        {isIesue && <a class="series-back" href="/archive/#iesues">← The monthly Iesues</a>}
        <div class="kicker">
          <span>{noteLabel}</span>
          {note.data.theme && <a class="theme" href={`/archive/?theme=${note.data.theme}#iesues`}>The {note.data.theme}</a>}
          <a href={`/topics/${topicSlug}/`}>{note.data.topic}</a>
        </div>
        <h1>{note.data.title}</h1>
        <p class="dek">{note.data.description}</p>
        <div class="article-meta">
          <time datetime={note.data.date.toISOString()}>{isIesue ? `Published ${fmt.format(note.data.published ?? note.data.date)}` : fmt.format(note.data.date)}</time>
          <span>Joseph E. Iesue</span>
          <span>≈ {readingMinutes} min read</span>
        </div>
        {note.data.updated && <p class="edition-update">Updated {fmt.format(note.data.updated)}</p>}
        <div class="article-divider" aria-hidden="true"><img src="/emblem-gold.svg" alt="" width="26" height="26" /></div>
      </header>

      <div class="article-body">
        {isIesue && note.data.outline && (
          <nav class="toc" aria-label="In this Iesue">
            <details open>
              <summary>In this Iesue <span aria-hidden="true">+</span></summary>
              <ol>{note.data.outline.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ol>
            </details>
          </nav>
        )}
        <div class="prose-panel"><div class="prose"><Content /></div></div>
      </div>

      <ShareBar title={note.data.title} description={note.data.description} slug={note.slug} label={isIesue ? 'Iesue' : 'note'} />

      {isIesue && <nav class="issue-nav" aria-label="Continue reading">
        {previous ? <a class="panel glow-card" href={`/${previous.slug}/`}><small>← Iesue {String(previous.data.iesue).padStart(3, '0')}</small><strong>{previous.data.title}</strong></a> : <a class="panel glow-card" href="/about/"><small>Start here</small><strong>A way to put your strength to use</strong></a>}
        {next ? <a class="panel glow-card" href={`/${next.slug}/`}><small>Iesue {String(next.data.iesue).padStart(3, '0')} →</small><strong>{next.data.title}</strong></a> : <a class="panel glow-card" href="/archive/#iesues"><small>Explore the series →</small><strong>Find your next question</strong></a>}
      </nav>}
      <footer class="article-end">
        <span>Strength to serve. Service to grow.</span>
        <a href="/archive/">Explore the archive →</a>
      </footer>
    </div>
  </article>
</BaseLayout>

<script>
  const contents = document.querySelector<HTMLDetailsElement>('.toc details');
  const compact = window.matchMedia('(max-width: 1180px)');
  const setContents = () => { if (contents) contents.open = !compact.matches; };
  setContents();
  compact.addEventListener('change', setContents);
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  const headings = links.map(link => document.getElementById(link.hash.slice(1))).filter(Boolean) as HTMLElement[];
  let queued = false;
  const markSection = () => {
    let current: HTMLElement | undefined;
    for (const heading of headings) {
      if (heading.getBoundingClientRect().top <= 180) current = heading;
    }
    links.forEach(link => {
      if (current && link.hash === `#${current.id}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
    queued = false;
  };
  if (headings.length) {
    markSection();
    window.addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(markSection); }
    }, { passive: true });
  }
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const body = document.querySelector<HTMLElement>('.prose');
  let ticking = false;
  const progress = () => {
    if (bar && body) {
      const r = body.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - window.innerHeight * 0.6)));
      bar.style.setProperty('--p', p.toFixed(4));
    }
    ticking = false;
  };
  progress();
  window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(progress); } }, { passive: true });
</script>
