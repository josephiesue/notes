---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const iesues = notes.filter((note) => note.data.format === 'iesue');
const featured = iesues[0];
const recentIesues = iesues.slice(1, 5);
const recent = notes.filter((note) => note.data.format === 'practical').slice(0, 4);
const fmt = new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const month = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const num = (n: number) => String(n).padStart(3, '0');
const fourYeses = [
  { key: 'Mirror', dir: 'North', pos: 'n', copy: 'Develops the self.' },
  { key: 'Weight', dir: 'East', pos: 'e', copy: 'Puts strength to service.' },
  { key: 'Ground', dir: 'South', pos: 's', copy: 'Shapes growth.' },
  { key: 'Path', dir: 'West', pos: 'w', copy: 'Keeps the journey your own.' },
];
const ticks = Array.from({ length: 72 }, (_, i) => i);
---
<BaseLayout title="The Yes-Way" scene="home">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <div class="hero-copy">
        {featured && <p class="hero-chip"><i></i><span>Monthly letter</span><b>Iesue №{num(featured.data.iesue!)}</b><span>{month.format(featured.data.date)}</span></p>}
        <h1 id="hero-title">
          <span class="line"><span style="--d:.15s">Strength to <span class="gold-text">Serve.</span></span></span>
          <span class="line"><span style="--d:.3s">Service to <span class="gold-text">Grow.</span></span></span>
        </h1>
        <p class="hero-lede">A practical philosophy for choosing what deserves your whole yes, then walking that path with courage, discipline, and service.</p>
        <div class="hero-actions">
          <a class="btn btn-gold" href={featured ? `/${featured.slug}/` : '/archive/'}>Read the latest Iesue <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href="/about/">Start here</a>
        </div>
        <p class="hero-say">Iesue, said properly, sounds like <b>yes way</b>.</p>
      </div>
    </div>
    <div class="scroll-cue" aria-hidden="true"><i></i>Scroll</div>
  </section>

  {featured && <section class="section" aria-labelledby="featured-title">
    <div class="wrap">
      <header class="section-head reveal"><div><p class="eyebrow">This month</p><h2>The latest Iesue</h2></div></header>
      <article class="featured panel glow-card reveal" data-yes={featured.data.theme}>
        <div class="featured-number" aria-hidden="true">
          <svg viewBox="0 0 200 200" fill="none"><circle cx="100" cy="100" r="78" stroke="rgba(223,184,78,.25)" /><circle cx="100" cy="100" r="92" stroke="rgba(143,167,255,.18)" stroke-dasharray="2 5" /></svg>
          <small>Iesue</small><strong>№{num(featured.data.iesue!)}</strong>
        </div>
        <div class="featured-body">
          <p class="meta"><span>The {featured.data.theme}</span><time datetime={featured.data.date.toISOString()}>{month.format(featured.data.date)} edition</time></p>
          <h3 id="featured-title"><a href={`/${featured.slug}/`}>{featured.data.title}</a></h3>
          <p>{featured.data.description}</p>
          <a class="text-link" href={`/${featured.slug}/`}>Read the Iesue <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </section>}

  {recentIesues.length > 0 && <section class="section" aria-labelledby="past-title" style="padding-top:0">
    <div class="wrap">
      <header class="section-head reveal">
        <div><p class="eyebrow">Keep exploring</p><h2 id="past-title">Past Iesues</h2></div>
        <a class="text-link" href="/archive/#iesues">The complete series <span aria-hidden="true">→</span></a>
      </header>
      <div class="rail">
        {recentIesues.map((note, i) => <a class="issue-card panel glow-card reveal" style={`--d:${i * 0.08}s`} href={`/${note.slug}/`} data-yes={note.data.theme}>
          <header><span class="num">№{num(note.data.iesue!)}</span><span class="pill">The {note.data.theme}</span></header>
          <h3>{note.data.title}</h3>
          <p>{note.data.description}</p>
          <footer><time datetime={note.data.date.toISOString()}>{month.format(note.data.date)}</time><span aria-hidden="true">↗</span></footer>
        </a>)}
      </div>
    </div>
  </section>}

  <section class="section" id="four-yeses" aria-labelledby="four-yeses-title">
    <div class="wrap">
      <header class="section-head reveal">
        <div><p class="eyebrow">A compass for practice</p><h2 id="four-yeses-title">The Four Yeses</h2></div>
        <a class="text-link" href="https://josephiesue.com/yes-way" target="_blank" rel="noopener">Read the full canon <span aria-hidden="true">↗</span></a>
      </header>
      <div class="compass">
        <div class="compass-core reveal" aria-hidden="true">
          <svg class="rings" viewBox="0 0 300 300" fill="none">
            <g class="spin">{ticks.map((i) => <line x1="150" y1={i % 6 === 0 ? 8 : 16} x2="150" y2="24" stroke={i % 6 === 0 ? 'rgba(245,216,115,.7)' : 'rgba(223,184,78,.3)'} transform={`rotate(${i * 5} 150 150)`} />)}</g>
            <circle cx="150" cy="150" r="118" stroke="rgba(223,184,78,.28)" />
            <circle class="spin-rev" cx="150" cy="150" r="100" stroke="rgba(143,167,255,.3)" stroke-dasharray="3 6" />
            <path d="M150 0V300M0 150H300" stroke="rgba(223,184,78,.18)" />
            <text x="150" y="46" fill="#a9bdf5" font-family="Archivo, sans-serif" font-size="10" letter-spacing="3" text-anchor="middle">N</text>
            <text x="258" y="154" fill="#f2cf6a" font-family="Archivo, sans-serif" font-size="10" letter-spacing="3" text-anchor="middle">E</text>
            <text x="150" y="262" fill="#d79a62" font-family="Archivo, sans-serif" font-size="10" letter-spacing="3" text-anchor="middle">S</text>
            <text x="42" y="154" fill="#84d0c4" font-family="Archivo, sans-serif" font-size="10" letter-spacing="3" text-anchor="middle">W</text>
          </svg>
          <img src="/emblem-gold.svg" alt="" width="100" height="100" />
        </div>
        {fourYeses.map((yes, i) => <article class={`yes yes-${yes.pos} panel glow-card reveal`} style={`--d:${i * 0.1}s`} data-yes={yes.key}>
          <a href={`/archive/?theme=${yes.key}#iesues`}>
            <span class="dir"><span>{yes.dir}</span><span>0{i + 1}</span></span>
            <h3>The {yes.key}</h3>
            <p>{yes.copy}</p>
            <span class="explore">Explore the essays →</span>
          </a>
        </article>)}
      </div>
    </div>
  </section>

  {recent.length > 0 && <section class="section" aria-labelledby="recent-title" style="padding-top:0">
    <div class="wrap">
      <header class="section-head reveal">
        <div><p class="eyebrow">Along the way</p><h2 id="recent-title">Practical Notes</h2></div>
        <a class="text-link" href="/archive/#practical">View all <span aria-hidden="true">→</span></a>
      </header>
      <ol class="note-list reveal">
        {recent.map((note) => <li>
          <a href={`/${note.slug}/`}>
            <span class="star" aria-hidden="true">✦</span>
            <strong>{note.data.title}</strong>
            <span class="excerpt">{note.data.description}</span>
            <time datetime={note.data.date.toISOString()}>{fmt.format(note.data.date)}</time>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M14 6l6 6-6 6" /></svg>
          </a>
        </li>)}
      </ol>
    </div>
  </section>}
</BaseLayout>
