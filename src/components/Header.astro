---
const path = Astro.url.pathname;
const active = (href: string) => path.startsWith(href);
---
<header class="site-header" data-header>
  <div class="header-inner">
    <a class="masthead" href="/" aria-label="The Yes-Way home">
      <img src="/emblem-gold.svg" alt="" width="40" height="40" />
      <span><strong>The Yes-Way</strong><small>by Joseph E. Iesue</small></span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-toggle>
      <span></span><span></span><i class="sr-only">Menu</i>
    </button>
    <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation" data-nav>
      <a class:list={{ active: active('/about/') }} href="/about/">Start here</a>
      <a href="/#four-yeses">The Four Yeses</a>
      <a class:list={{ active: active('/archive/') || active('/topics/') }} href="/archive/">Archive</a>
      <a href="https://josephiesue.com" target="_blank" rel="noopener">josephiesue.com <span aria-hidden="true">↗</span></a>
      <a class="nav-cta" href="#subscribe">Subscribe</a>
      <p class="nav-foot">Strength to serve. Service to grow.</p>
    </nav>
  </div>
</header>
