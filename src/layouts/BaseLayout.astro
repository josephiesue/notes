---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Subscribe from '../components/Subscribe.astro';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  updatedTime?: Date;
  socialImage?: string;
  scene?: 'home' | 'page' | 'article';
}
const {
  title,
  description = 'The Yes-Way is a practical philosophy for building strength, choosing responsibility, and putting work in service of something larger.',
  canonicalPath = Astro.url.pathname,
  type = 'website',
  publishedTime,
  updatedTime,
  socialImage = "/social/yes-way.png",
  scene = 'page',
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site ?? 'https://notes.josephiesue.com').toString();
const socialImageUrl = new URL(socialImage, Astro.site ?? "https://notes.josephiesue.com").toString();
const socialImageAlt = `${title} — The Yes-Way, by Joseph E. Iesue`;
const pageTitle = title === 'The Yes-Way' ? 'The Yes-Way | Joseph E. Iesue' : `${title} | The Yes-Way`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://josephiesue.com/#person',
      name: 'Joseph E. Iesue',
      url: 'https://josephiesue.com/',
      sameAs: ['https://josephiesue.com/', 'https://entr.cc/'],
    },
    {
      '@type': 'WebSite',
      '@id': 'https://notes.josephiesue.com/#website',
      url: 'https://notes.josephiesue.com/',
      name: 'The Yes-Way',
      description: 'A practical philosophy for building strength, choosing responsibility, and putting work in service of something larger.',
      publisher: { '@id': 'https://josephiesue.com/#person' },
    },
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="author" href="https://josephiesue.com/" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta name="author" content="Joseph E. Iesue" />
    <meta name="theme-color" content="#06090f" />
    <meta name="robots" content="index,follow" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="The Yes-Way" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime.toISOString()} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="The Yes-Way" href="/rss.xml" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body data-scene={scene}>
    <div class="scene-poster" aria-hidden="true"></div>
    <canvas class="scene-canvas" data-scene-canvas aria-hidden="true"></canvas>
    <div class="scene-vignette" aria-hidden="true"></div>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content"><slot /><Subscribe /></main>
    <Footer />
    <script>
      // Header, menu, reveals, card light
      const header = document.querySelector('[data-header]');
      const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const nav = document.querySelector('[data-nav]');
      const setMenu = (open: boolean) => {
        menuButton?.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('is-open', open);
        document.body.classList.toggle('menu-open', open);
      };
      menuButton?.addEventListener('click', () => setMenu(menuButton.getAttribute('aria-expanded') !== 'true'));
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') { setMenu(false); menuButton.focus(); }
      });
      window.matchMedia('(min-width: 921px)').addEventListener('change', (event) => { if (event.matches) setMenu(false); });

      const setHeader = () => header?.classList.toggle('is-scrolled', window.scrollY > 24);
      setHeader();
      window.addEventListener('scroll', setHeader, { passive: true });

      const reveals = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); }
          });
        }, { threshold: .1, rootMargin: '0px 0px -6% 0px' });
        reveals.forEach((element) => observer.observe(element));
      } else {
        reveals.forEach((element) => element.classList.add('is-visible'));
      }

      document.querySelectorAll<HTMLElement>('.glow-card').forEach((card) => {
        card.addEventListener('pointermove', (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${e.clientX - r.left}px`);
          card.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });

      // Three.js scene, loaded after first paint
      const canvas = document.querySelector<HTMLCanvasElement>('[data-scene-canvas]');
      const boot = () => import('../scripts/yesway-scene').then(({ startScene }) => canvas && startScene(canvas)).catch(() => document.documentElement.classList.add('no-webgl'));
      if ('requestIdleCallback' in window) (window as any).requestIdleCallback(boot, { timeout: 1200 });
      else setTimeout(boot, 300);
    </script>
  </body>
</html>
